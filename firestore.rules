rules_version = '2';

// B2 Sprint. Each learner reads and writes only their own data under users/{uid}.
// Shared AI explanation cache: anyone may read; signed-in users may only create small,
// well-formed entries; nobody may change or delete them.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /explanations/{key} {
      allow read: if true;
      allow create: if request.auth != null
        && key.size() <= 80
        && request.resource.data.keys().hasOnly(['text', 'lang', 'createdAt'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 600
        && request.resource.data.lang in ['en', 'ru']
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
