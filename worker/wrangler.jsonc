{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "b2-sprint-ai",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "vars": {
    "ALLOWED_ORIGINS": "https://valorin777.github.io,http://localhost:3000,http://127.0.0.1:3000",
    "MODEL": "anthropic/claude-haiku-5.5"
  },
  // Workers Rate Limiting binding. period must be 10 or 60 seconds.
  "ratelimits": [
    {
      "name": "LIMITER",
      "namespace_id": "2601",
      "simple": { "limit": 30, "period": 60 }
    }
  ]
  // Secret, never in this file: npx wrangler secret put OPENROUTER_API_KEY
}
